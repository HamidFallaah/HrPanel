@model HrPanel.UI.Models.Scheduling.ScheduleFormViewModel
@using HrPanel.Domain.Scheduling
@{
    var edit = Model.Id.HasValue; ViewData[ViewDataKeys.Title] = edit ? "ویرایش برنامه کاری" : "برنامه کاری جدید"; ViewData[ViewDataKeys.PageTitle] = ViewData[ViewDataKeys.Title];
}
<partial name="_SchedulingTabs" />
<div class="content-card form-card"><form asp-action="@(edit?"EditSchedule":"CreateSchedule")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3"><div class="col-md-4"><label class="form-label required">کد</label><input asp-for="Code" class="form-control" dir="ltr" /></div><div class="col-md-4"><label class="form-label required">نام فارسی</label><input asp-for="NameFa" class="form-control" /></div><div class="col-md-4"><label class="form-label">نام انگلیسی</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div><div class="col-md-4"><label class="form-label">نوع الگو</label><select asp-for="PatternType" class="form-select">@foreach(var x in Enum.GetValues<WorkSchedulePatternType>()){
<option value="@x">@x</option>
}
</select></div><div class="col-md-4"><label class="form-label">طول چرخه (روز)</label><input asp-for="CycleLengthDays" type="number" class="form-control" /></div><div class="col-md-4"><label class="form-label">تاریخ مبنا</label><input asp-for="AnchorDate" class="form-control" data-jdp autocomplete="off" /></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Schedules">انصراف</a><button class="btn btn-primary">ذخیره</button></div></form></div>
