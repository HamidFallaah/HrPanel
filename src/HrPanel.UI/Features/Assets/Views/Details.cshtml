@model AssetDetailsDto
@using HrPanel.Domain.Assets
@{
    var employees = (IReadOnlyCollection<EmployeeListItemDto>)ViewBag.Employees; ViewData[ViewDataKeys.Title] = Model.AssetTypeName; ViewData[ViewDataKeys.PageTitle] = "جزئیات دارایی"; var active = Model.Assignments.FirstOrDefault(x => x.IsActive);
}
<section class="profile-hero content-card"><div class="profile-identity"><span class="profile-avatar"><i class="bi bi-phone"></i></span><div><div class="d-flex align-items-center gap-2"><h1>@Model.AssetTypeName</h1><span class="status-badge">@DisplayNames.AssetStatuses(Model.Status)</span></div><p>@(Model.AssetTag ?? Model.SerialNumber ?? Model.Imei ?? "بدون شناسه نمایشی")</p></div></div><div class="profile-actions"><a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">ویرایش</a>@if(Model.Status==AssetStatus.Available){
<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assign-modal">واگذاری</button>
}
@if (Model.Status == AssetStatus.Assigned)
{
    <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#return-modal">بازگشت</button>
}
</div></section>
<div class="detail-grid"><section class="content-card"><div class="card-heading"><h2>مشخصات</h2></div><dl class="detail-list"><div><dt>نوع</dt><dd>@Model.AssetTypeName</dd></div><div><dt>برچسب</dt><dd>@(Model.AssetTag ?? "—")</dd></div><div><dt>شماره خدمت</dt><dd dir="ltr">@(Model.ServiceNumber ?? "—")</dd></div><div><dt>IMEI</dt><dd dir="ltr">@(Model.Imei ?? "—")</dd></div><div><dt>سریال</dt><dd dir="ltr">@(Model.SerialNumber ?? "—")</dd></div><div><dt>یادداشت</dt><dd>@(Model.Notes ?? "—")</dd></div></dl></section><section class="content-card"><div class="card-heading"><h2>تغییر وضعیت</h2></div><div class="action-stack">@if(Model.Status is AssetStatus.Available or AssetStatus.UnderMaintenance){
<form asp-action="Maintenance" asp-route-id="@Model.Id" method="post" data-confirm="ارسال دارایی به تعمیر"><button class="btn btn-outline-warning w-100">ارسال به تعمیر</button></form>
}
@if (Model.Status != AssetStatus.Assigned && Model.Status != AssetStatus.Retired)
{
    <form asp-action="Retire" asp-route-id="@Model.Id" method="post" data-confirm="از رده خارج‌کردن دارایی"><button class="btn btn-outline-dark w-100">از رده خارج</button></form>
}
@if (Model.Status != AssetStatus.Retired)
{
    <form asp-action="Lost" asp-route-id="@Model.Id" method="post" data-confirm="ثبت دارایی به‌عنوان مفقود"><button class="btn btn-outline-danger w-100">ثبت مفقودی</button></form>
}
</div></section></div>
<section class="content-card mt-4"><div class="card-heading"><h2>تاریخچه واگذاری</h2></div>@if(Model.Assignments.Count==0){
<partial name="_EmptyState" model='new EmptyStateViewModel("واگذاری ‌ای ثبت نشده", "این دارایی هنوز به کارمندی واگذار نشده است", "bi-arrow-left-right")' />
}else
{

    <div class="table-responsive"><table class="table data-table"><thead><tr><th>کارمند</th><th>تاریخ واگذاری</th><th>تاریخ بازگشت</th><th>یادداشت</th></tr></thead><tbody>@foreach(var x in Model.Assignments){
    <tr><td><a asp-controller="Employees" asp-action="Details" asp-route-id="@x.EmployeeId">@x.EmployeeDisplayName</a><small class="d-block">@x.EmployeeNumber</small></td><td>@PersianDate.Format(x.AssignedAt)</td><td>@PersianDate.Format(x.ReturnedAt)</td><td>@(x.Notes ?? "—")</td></tr>
}
</tbody></table></div>
}
</section>
<div class="modal fade" id="assign-modal"><div class="modal-dialog"><div class="modal-content"><form asp-action="Assign" asp-route-id="@Model.Id" method="post"><div class="modal-header"><h2 class="modal-title fs-5">واگذاری دارایی</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">کارمند</label><select name="employeeId" class="form-select mb-3"><option value="">انتخاب کنید</option>@foreach(var x in employees){
<option value="@x.Id">@($"{x.FirstNameFa} {x.LastNameFa}") — @x.EmployeeNumber</option>
}
</select><label class="form-label">تاریخ واگذاری</label><input name="assignedAt" class="form-control mb-3" data-jdp required /><label class="form-label">یادداشت</label><textarea name="notes" class="form-control"></textarea></div><div class="modal-footer"><button class="btn btn-primary">واگذاری</button></div></form></div></div></div>
<div class="modal fade" id="return-modal"><div class="modal-dialog"><div class="modal-content"><form asp-action="Return" asp-route-id="@Model.Id" method="post"><div class="modal-header"><h2 class="modal-title fs-5">بازگشت دارایی</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>دارنده فعلی: <strong>@active?.EmployeeDisplayName</strong></p><label class="form-label">تاریخ بازگشت</label><input name="returnedAt" class="form-control" data-jdp required /></div><div class="modal-footer"><button class="btn btn-success">ثبت بازگشت</button></div></form></div></div></div>
