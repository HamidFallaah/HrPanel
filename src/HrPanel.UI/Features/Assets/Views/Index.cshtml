@model PagedResult<AssetListItemDto>
@{
    var lookups = (AssetLookupsDto)ViewBag.Lookups; ViewData[ViewDataKeys.Title] = "دارایی‌ ها"; ViewData[ViewDataKeys.PageTitle] = "دارایی‌ ها"; ViewData[ViewDataKeys.PageDescription] = "ثبت، واگذاری، بازگشت و پیگیری وضعیت تجهیزات";
}
<div class="page-actions"><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> ثبت دارایی</a></div>
<section class="content-card"><form method="get" class="filter-bar"><div class="filter-search"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" class="form-control" placeholder="برچسب، سریال، IMEI یا شماره خدمت" /></div><select name="assetTypeId" class="form-select"><option value="">همه انواع</option>@foreach(var x in lookups.AssetTypes){
<option value="@x.Id" selected="@(x.Id == ViewBag.AssetTypeId)">@x.DisplayName</option>
}
</select><select name="status" class="form-select"><option value="">همه وضعیت‌ها</option>@foreach(var x in lookups.AssetStatuses){
<option value="@x.Id">@x.DisplayName</option>
}
</select><button class="btn btn-dark">اعمال فیلتر</button><a class="btn btn-outline-secondary" asp-action="Index">پاک‌کردن</a></form>@if(Model.Items.Count==0){
<partial name="_EmptyState" model='new EmptyStateViewModel("دارایی‌ ای یافت نشد", "فیلترها را تغییر دهید یا دارایی جدید ثبت کنید", "bi-phone")' />
}else
{

    <div class="asset-grid">@foreach(var x in Model.Items){
    <article class="asset-card"><div class="asset-card-top"><span class="metric-icon bg-yellow"><i class="bi bi-phone"></i></span><span class="status-badge status-@x.Status.ToString().ToLowerInvariant()">@DisplayNames.AssetStatus(x.Status)</span></div><h2>@x.AssetTypeName</h2><dl><div><dt>برچسب</dt><dd>@(x.AssetTag ?? "—")</dd></div><div><dt>سریال / IMEI</dt><dd dir="ltr">@(x.SerialNumber ?? x.Imei ?? "—")</dd></div><div><dt>دارنده</dt><dd>@(x.AssignedEmployeeName ?? "—")</dd></div></dl><a class="btn btn-outline-dark w-100" asp-action="Details" asp-route-id="@x.Id">مشاهده جزئیات</a></article>
}
</div>
}
</section>
