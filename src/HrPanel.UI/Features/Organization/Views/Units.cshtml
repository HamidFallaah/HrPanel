@model PagedResult<OrganizationUnitDto>
@{
    var tree = (IReadOnlyCollection<OrganizationUnitTreeDto>)ViewBag.Tree; ViewData[ViewDataKeys.Title] = "ساختار سازمان"; ViewData[ViewDataKeys.PageTitle] = "ساختار سازمان"; ViewData[ViewDataKeys.PageDescription] = "واحدها، سمت‌ها، محل‌های کار و گروه‌های عملیاتی";
}
<partial name="_OrganizationTabs" />
<div class="page-actions"><a class="btn btn-primary" asp-action="CreateUnitFromView"><i class="bi bi-plus-lg"></i> واحد جدید</a></div>
<div class="organization-layout">
    <aside class="content-card tree-panel"><div class="card-heading"><h2>درخت سازمانی</h2></div>@if(tree.Count==0){
    <p class="muted">ساختار سازمانی خالی است.</p>
        }else
    {

        <ul class="org-tree">@foreach(var root in tree){
        <li><span><i class="bi bi-building"></i>@root.NameFa</span>@if(root.Children.Count>0){
        <ul>@foreach(var child in root.Children){
        <li><span><i class="bi bi-diagram-2"></i>@child.NameFa</span></li>
    }
</ul>
        }
</li>
        }
</ul>
        }
</aside>
    <section class="content-card"><form method="get" class="filter-bar"><div class="filter-search"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" class="form-control" placeholder="کد یا نام واحد" /></div><select name="isActive" class="form-select"><option value="">همه وضعیت‌ها</option><option value="true">فعال</option><option value="false">غیرفعال</option></select><button class="btn btn-dark">جست‌وجو</button></form>@if(Model.Items.Count==0){
    <partial name="_EmptyState" model='new EmptyStateViewModel("واحدی یافت نشد", "واحد سازمانی جدید ثبت کنید", "bi-diagram-3")' />
        }else
    {

        <div class="table-responsive"><table class="table data-table"><thead><tr><th>واحد</th><th>کد</th><th>نوع</th><th>والد</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){
        <tr><td><strong>@x.NameFa</strong><small class="d-block" dir="ltr">@x.NameEn</small></td><td>@x.Code</td><td>@x.OrganizationUnitTypeName</td><td>@(x.ParentOrganizationUnitName ?? "ریشه")</td><td><span class="status-badge @(x.IsActive ? "status-active" : "status-inactive")">@(x.IsActive ? "فعال" : "غیرفعال")</span></td><td class="table-actions"><a class="btn btn-sm btn-outline-dark" asp-action="EditUnit" asp-route-id="@x.Id">ویرایش</a><form asp-action="UnitStatus" asp-route-id="@x.Id" method="post"><input name="isActive" type="hidden" value="@(x.IsActive ? "false" : "true")" /><button class="btn btn-sm btn-link">@(x.IsActive ? "غیرفعال" : "فعال")</button></form></td></tr>
    }
</tbody></table></div>
        }
</section>
</div>
