@model HrPanel.UI.Models.Organization.OrganizationItemFormViewModel
@using HrPanel.Domain.Organization
@{
    var edit = Model.Id.HasValue; var title = Model.Section switch { "positions" => "سمت سازمانی", "locations" => "محل کار", _ => "گروه عملیاتی" }; ViewData[ViewDataKeys.Title] = $"{(edit ? "ویرایش" : "ثبت")} {title}"; ViewData[ViewDataKeys.PageTitle] = ViewData[ViewDataKeys.Title];
}
<partial name="_OrganizationTabs" />
<div class="content-card form-card"><form asp-action="@(edit?"EditItem":"CreateItem")" asp-route-section="@Model.Section" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3"><div class="col-md-4"><label class="form-label required">کد</label><input asp-for="Code" class="form-control" dir="ltr" readonly="@(edit && Model.Section == "groups")" /></div><div class="col-md-4"><label class="form-label required">@(Model.Section == "positions" ? "عنوان فارسی" : "نام فارسی")</label><input asp-for="NameFa" class="form-control" /></div>@if(Model.Section!="groups"){
<div class="col-md-4"><label class="form-label">نام انگلیسی</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div>
}
@if (Model.Section == "locations")
{
    <div class="col-md-4"><label class="form-label">استان</label><input asp-for="Province" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">شهر</label><input asp-for="City" class="form-control" /></div>

    <div class="col-12"><label class="form-label">نشانی</label><textarea asp-for="Address" class="form-control"></textarea></div>
}
@if (Model.Section == "groups")
{
    <div class="col-md-4"><label class="form-label">نوع گروه</label><select asp-for="GroupType" class="form-select">@foreach(var x in Enum.GetValues<OperationalGroupType>()){
    <option value="@x">@x</option>
}
</select></div>
}
</div><div class="form-actions"><a class="btn btn-outline-secondary" href="@Url.Action(Model.Section == "positions" ? "Positions" : Model.Section == "locations" ? "Locations" : "Groups")">انصراف</a><button class="btn btn-primary">ذخیره</button></div></form></div>
