@model PagedResult<PositionDto>
@{
    ViewData[ViewDataKeys.Title] = "سمت‌ ها"; ViewData[ViewDataKeys.PageTitle] = "سمت‌ های سازمانی";
}
<partial name="_OrganizationTabs" />
<div class="page-actions"><a class="btn btn-primary" asp-action="CreateItem" asp-route-section="positions">سمت جدید</a></div>
<section class="content-card"><form class="filter-bar"><div class="filter-search"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" class="form-control" placeholder="کد یا عنوان" /></div><button class="btn btn-dark">جست‌وجو</button></form>@if(Model.Items.Count==0){
<partial name="_EmptyState" model='new EmptyStateViewModel("سمتی یافت نشد", "سمت سازمانی جدید ثبت کنید", "bi-briefcase")' />
}else
{

    <div class="table-responsive"><table class="table data-table"><thead><tr><th>عنوان</th><th>کد</th><th>عنوان انگلیسی</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){
    <tr><td>@x.TitleFa</td><td dir="ltr">@x.Code</td><td dir="ltr">@(x.TitleEn ?? "—")</td><td><span class="status-badge @(x.IsActive ? "status-active" : "status-inactive")">@(x.IsActive ? "فعال" : "غیرفعال")</span></td><td class="table-actions"><a class="btn btn-sm btn-outline-dark" asp-action="EditItem" asp-route-section="positions" asp-route-id="@x.Id">ویرایش</a><form asp-action="ItemStatus" asp-route-section="positions" asp-route-id="@x.Id" method="post"><input type="hidden" name="isActive" value="@(x.IsActive ? "false" : "true")" /><button class="btn btn-sm btn-link">تغییر وضعیت</button></form></td></tr>
}
</tbody></table></div>
}
</section>
