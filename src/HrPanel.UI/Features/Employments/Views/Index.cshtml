@model PagedResult<EmploymentListItemDto>
@{
    ViewData[ViewDataKeys.Title] = "استخدام‌ها"; ViewData[ViewDataKeys.PageTitle] = "استخدام‌ها"; ViewData[ViewDataKeys.PageDescription] = "مدیریت چرخه استخدام، تخصیص سازمانی و برنامه کاری"; string? search = ViewBag.Search; bool? current = ViewBag.IsCurrent;
}
<div class="page-actions"><a class="btn btn-outline-dark" asp-action="ExternalPeople"><i class="bi bi-person-lines-fill"></i> اشخاص بیرونی</a><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> شروع استخدام</a></div>
<section class="content-card">
    <form method="get" class="filter-bar"><div class="filter-search"><i class="bi bi-search"></i><input name="search" value="@search" class="form-control" placeholder="نام یا شماره پرسنلی" /></div><select name="isCurrent" class="form-select"><option value="">همه سوابق</option><option value="true" selected="@(current == true)">جاری</option><option value="false" selected="@(current == false)">پایان‌یافته</option></select><button class="btn btn-dark">اعمال فیلتر</button><a class="btn btn-outline-secondary" asp-action="Index">پاک‌کردن</a></form>
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateViewModel("استخدامی یافت نشد", "فیلترها را تغییر دهید یا استخدام جدیدی آغاز کنید", "bi-person-vcard")' />
    }
    else
    {

        <div class="table-responsive"><table class="table data-table"><thead><tr><th>کارمند</th><th>نوع استخدام</th><th>وضعیت</th><th>ساعت کاری</th><th>شروع</th><th>پایان</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){
        <tr><td><div class="person-cell"><span class="list-avatar">@item.EmployeeDisplayName.First()</span><span><strong>@item.EmployeeDisplayName</strong><small>@item.EmployeeNumber</small></span></div></td><td>@item.EmploymentTypeName</td><td><span class="status-badge @(item.IsCurrent ? "status-active" : "status-inactive")">@item.EmploymentStatusName</span></td><td>@(item.WorkTimeTypeName ?? "—")</td><td>@PersianDate.Format(item.StartDate)</td><td>@PersianDate.Format(item.EndDate)</td><td><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@item.Id">جزئیات</a></td></tr>
    }
</tbody></table></div>
    <div class="pagination-bar"><span><b data-persian-number>@Model.TotalCount</b> سابقه</span><nav><ul class="pagination mb-0"><li class="page-item @(!Model.HasPreviousPage ? "disabled" : null)"><a class="page-link" asp-route-search="@search" asp-route-isCurrent="@current" asp-route-page="@(Model.PageNumber - 1)">قبلی</a></li><li class="page-item active"><span class="page-link" data-persian-number>@Model.PageNumber</span></li><li class="page-item @(!Model.HasNextPage ? "disabled" : null)"><a class="page-link" asp-route-search="@search" asp-route-isCurrent="@current" asp-route-page="@(Model.PageNumber + 1)">بعدی</a></li></ul></nav></div>
}
</section>
