@model HrPanel.UI.Models.Authentication.ChangePasswordViewModel
@{
    ViewData[ViewDataKeys.Title] = "تغییر رمز عبور"; ViewData[ViewDataKeys.PageTitle] = "تغییر رمز عبور"; ViewData[ViewDataKeys.PageDescription] = "برای حفظ امنیت حساب، رمز جدید و غیرتکراری انتخاب کنید.";
}
<div class="content-card form-card form-card-narrow">
    <form asp-controller="Auth" asp-action="ChangePasswordPage" method="post" data-prevent-double-submit>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span><div class="form-text">حداقل ۸ نویسه، شامل حرف کوچک و عدد</div></div>
        <div class="mb-4"><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword"></span></div>
        <button class="btn btn-primary" type="submit">ذخیره رمز جدید</button>
    </form>
</div>
