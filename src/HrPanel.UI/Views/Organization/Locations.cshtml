@using HrPanel.UI.Common.Constants
@model PagedResult<WorkLocationDto>
@{
    ViewData[ViewDataKeys.Title] = "محل‌ های کار"; ViewData[ViewDataKeys.PageTitle] = "محل‌ های کار";
}
<partial name="_OrganizationTabs" />
<div class="page-actions"><a class="btn btn-primary" asp-action="CreateItem" asp-route-section="locations">محل جدید</a></div>
<section class="content-card">@if(Model.Items.Count==0){
<partial name="_EmptyState" model='new EmptyStateViewModel("محلی یافت نشد", "محل کار جدید ثبت کنید", "bi-geo-alt")' />
}else
{

    <div class="table-responsive"><table class="table data-table"><thead><tr><th>نام</th><th>کد</th><th>استان / شهر</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){
    <tr><td>@x.NameFa</td><td>@x.Code</td><td>@x.Province / @x.City</td><td><span class="status-badge @(x.IsActive ? "status-active" : "status-inactive")">@(x.IsActive ? "فعال" : "غیرفعال")</span></td><td class="table-actions"><a class="btn btn-sm btn-outline-dark" asp-action="EditItem" asp-route-section="locations" asp-route-id="@x.Id">ویرایش</a><form asp-action="ItemStatus" asp-route-section="locations" asp-route-id="@x.Id" method="post"><input type="hidden" name="isActive" value="@(x.IsActive ? "false" : "true")" /><button class="btn btn-sm btn-link">تغییر وضعیت</button></form></td></tr>
}
</tbody></table></div>
}
</section>
