@using HrPanel.UI.Common.Constants
@model PagedResult<OperationalGroupDto>
@{
    ViewData[ViewDataKeys.Title] = "گروه‌های عملیاتی"; ViewData[ViewDataKeys.PageTitle] = "گروه‌های عملیاتی";
}
<partial name="_OrganizationTabs" />
<div class="page-actions"><a class="btn btn-primary" asp-action="CreateItem" asp-route-section="groups">گروه جدید</a></div>
<section class="content-card">@if(Model.Items.Count==0){
<partial name="_EmptyState" model='new EmptyStateViewModel("گروهی یافت نشد", "گروه عملیاتی جدید ثبت کنید.", "bi-people")' />
}else
{

    <div class="table-responsive"><table class="table data-table"><thead><tr><th>نام</th><th>کد</th><th>نوع</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){
    <tr><td>@x.Name</td><td>@x.Code</td><td>@x.Type</td><td><span class="status-badge @(x.IsActive ? "status-active" : "status-inactive")">@(x.IsActive ? "فعال" : "غیرفعال")</span></td><td class="table-actions"><a class="btn btn-sm btn-outline-dark" asp-action="EditItem" asp-route-section="groups" asp-route-id="@x.Id">ویرایش</a><form asp-action="ItemStatus" asp-route-section="groups" asp-route-id="@x.Id" method="post"><input type="hidden" name="isActive" value="@(x.IsActive ? "false" : "true")" /><button class="btn btn-sm btn-link">تغییر وضعیت</button></form></td></tr>
}
</tbody></table></div>
}
</section>
