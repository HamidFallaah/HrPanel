@model EmptyStateViewModel
<div class="state-card empty-state" role="status">
    <span class="state-icon" aria-hidden="true"><i class="bi @Model.Icon"></i></span>
    <h2>@Model.Title</h2>
    <p>@Model.Message</p>
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
    {
        <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</div>
