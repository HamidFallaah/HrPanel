@using HrPanel.UI.Common.Constants
@model ErrorPageViewModel
@{
    ViewData[ViewDataKeys.Title] = Model.Title;
}
<section class="error-page">
    <div class="error-code" data-persian-number>@Model.StatusCode</div>
    <span class="error-icon" aria-hidden="true"><i class="bi @Model.Icon"></i></span>
    <h2>@Model.Title</h2>
    <p>@Model.Message</p>
    <div class="error-actions">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-house-door" aria-hidden="true"></i>
            بازگشت به داشبورد
        </a>
        @if (Model.CanRetry)
        {
            <button class="btn btn-outline-dark" type="button" data-retry-page>
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                تلاش دوباره
            </button>
        }
    </div>
</section>
