@using HrPanel.UI.Common.Constants
@model HrPanel.UI.Models.Employees.EditEmployeeViewModel
@{
    ViewData[ViewDataKeys.Title] = "ویرایش کارمند"; ViewData[ViewDataKeys.PageTitle] = "ویرایش اطلاعات کارمند";
}
<div class="content-card form-card mb-4">
    <form asp-action="UpdateNumber" asp-route-id="@Model.Id" method="post" data-prevent-double-submit>
        <div class="form-section"><div class="form-section-heading"><i class="bi bi-person-badge"></i><div><h2>شماره پرسنلی</h2><p>این شناسه مستقل از اطلاعات شخصی ذخیره می‌شود.</p></div></div><div class="row g-3"><div class="col-md-6"><label class="form-label required">شماره پرسنلی</label><input name="employeeNumber" value="@Model.EmployeeNumber" class="form-control" dir="ltr" required /></div></div></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">ذخیره شماره پرسنلی</button></div>
    </form>
</div>
<div class="content-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-prevent-double-submit>
        <input asp-for="EmployeeNumber" type="hidden" /><div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-section">
            <div class="form-section-heading"><i class="bi bi-person"></i><div><h2>اطلاعات هویتی</h2><p>این بخش مستقل از شماره پرسنلی ذخیره می‌شود.</p></div></div><div class="row g-3">
                <div class="col-md-4"><label class="form-label">کد ملی</label><input asp-for="NationalCode" class="form-control" dir="ltr" /></div>
                <div class="col-md-6"><label class="form-label required">نام فارسی</label><input asp-for="FirstNameFa" class="form-control" /><span asp-validation-for="FirstNameFa"></span></div><div class="col-md-6"><label class="form-label required">نام خانوادگی فارسی</label><input asp-for="LastNameFa" class="form-control" /><span asp-validation-for="LastNameFa"></span></div>
                <div class="col-md-6"><label class="form-label">نام انگلیسی</label><input asp-for="FirstName" class="form-control" dir="ltr" /></div><div class="col-md-6"><label class="form-label">نام خانوادگی انگلیسی</label><input asp-for="LastName" class="form-control" dir="ltr" /></div>
            </div>
        </div><div class="form-section">
            <div class="form-section-heading"><i class="bi bi-card-list"></i><div><h2>اطلاعات فردی</h2></div></div><div class="row g-3">
                <div class="col-md-4"><label class="form-label">نام پدر</label><input asp-for="FatherName" class="form-control" /><span asp-validation-for="FatherName"></span></div><div class="col-md-4"><label class="form-label">کد ملی پدر</label><input asp-for="FatherNationalCode" class="form-control" dir="ltr" /><span asp-validation-for="FatherNationalCode"></span></div><div class="col-md-4"><label class="form-label">تاریخ تولد</label><input asp-for="BirthDate" class="form-control" data-jdp autocomplete="off" placeholder="۱۴۰۰/۰۱/۰۱" /><span asp-validation-for="BirthDate"></span></div>
                <div class="col-md-4"><label class="form-label">محل تولد</label><input asp-for="BirthPlace" class="form-control" /></div><div class="col-md-4"><label class="form-label">جنسیت</label><select asp-for="Gender" class="form-select"><option value="0">نامشخص</option><option value="1">مرد</option><option value="2">زن</option></select></div><div class="col-md-4"><label class="form-label">وضعیت تأهل</label><select asp-for="MaritalStatus" class="form-select"><option value="0">نامشخص</option><option value="1">مجرد</option><option value="2">متأهل</option><option value="3">مطلقه</option><option value="4">همسر فوت ‌شده</option></select></div>
            </div>
        </div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">انصراف</a><button class="btn btn-primary" type="submit">ذخیره اطلاعات شخصی</button></div>
    </form>
</div>
