@using HrPanel.UI.Common.Constants
@model HrPanel.UI.Models.Authentication.LoginViewModel
@{
    Layout = null; ViewData[ViewDataKeys.Title] = "ورود";
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود | سامانه منابع انسانی شایا</title>
    <link rel="stylesheet" href="~/fonts/vazirmatn/vazirmatn.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-card" aria-labelledby="login-title">
            <div class="auth-brand"><img src="~/images/shaya-logo.webp" alt="نشان شایا" /><div><strong>سامانه منابع انسانی شایا</strong><span>ورود کاربران سازمانی</span></div></div>
            <div class="auth-copy"><h1 id="login-title">خوش آمدید</h1><p>برای دسترسی به فضای کاری، مشخصات حساب خود را وارد کنید</p></div>
            <form asp-controller="Auth" asp-action="LoginPage" method="post" data-prevent-double-submit>
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="mb-3"><label asp-for="UserName" class="form-label"></label><div class="input-icon"><i class="bi bi-person"></i><input asp-for="UserName" class="form-control" autocomplete="username" autofocus /></div><span asp-validation-for="UserName" class="field-validation-error"></span></div>
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><div class="input-icon"><i class="bi bi-lock"></i><input asp-for="Password" class="form-control" autocomplete="current-password" /></div><span asp-validation-for="Password" class="field-validation-error"></span></div>
                <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
                <button class="btn btn-primary w-100" type="submit">ورود به سامانه</button>
            </form>
        </section>
    </main>
    <script src="~/js/app.js"></script>
</body>
</html>
