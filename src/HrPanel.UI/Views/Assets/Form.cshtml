@using HrPanel.UI.Common.Constants
@model HrPanel.UI.Models.Assets.AssetViewModels
@{
    var lookups = (AssetLookupsDto)ViewBag.Lookups; var edit = Model.Id.HasValue; ViewData[ViewDataKeys.Title] = edit ? "ویرایش دارایی" : "ثبت دارایی"; ViewData[ViewDataKeys.PageTitle] = ViewData[ViewDataKeys.Title];
}
<div class="content-card form-card"><form asp-action="@(edit?"Edit":"Create")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section"><div class="form-section-heading"><i class="bi bi-upc-scan"></i><div><h2>مشخصات دارایی</h2><p>حداقل یکی از شناسه‌های دارایی را وارد کنید</p>
    </div></div><div class="row g-3"><div class="col-md-4"><label class="form-label required">نوع دارایی</label><select asp-for="AssetTypeId" class="form-select"><option value="0">انتخاب کنید</option>@foreach(var x in lookups.AssetTypes)
{
<option value="@x.Id">@x.DisplayName</option>
}
</select></div><div class="col-md-4"><label class="form-label">برچسب دارایی</label><input asp-for="AssetTag" class="form-control" dir="ltr" /></div><div class="col-md-4"><label class="form-label">شماره خدمت</label><input asp-for="ServiceNumber" class="form-control" dir="ltr" /></div><div class="col-md-6"><label class="form-label">IMEI</label><input asp-for="Imei" class="form-control" dir="ltr" /></div><div class="col-md-6"><label class="form-label">شماره سریال</label><input asp-for="SerialNumber" class="form-control" dir="ltr" /></div><div class="col-12"><label class="form-label">یادداشت</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">انصراف</a><button class="btn btn-primary">ذخیره</button></div></form></div>
