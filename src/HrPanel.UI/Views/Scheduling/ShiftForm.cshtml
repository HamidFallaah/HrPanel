@using HrPanel.UI.Common.Constants
@model HrPanel.UI.Models.Scheduling.ShiftFormViewModel
@{
    var edit = Model.Id.HasValue; ViewData[ViewDataKeys.Title] = edit ? "ویرایش شیفت" : "شیفت جدید"; ViewData[ViewDataKeys.PageTitle] = ViewData[ViewDataKeys.Title];
}
<partial name="_SchedulingTabs" />
<div class="content-card form-card"><form asp-action="@(edit ? "EditShift" : "CreateShift")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3"><div class="col-md-4"><label class="form-label required">کد</label><input asp-for="Code" class="form-control" dir="ltr" /></div><div class="col-md-4"><label class="form-label required">نام فارسی</label><input asp-for="NameFa" class="form-control" /></div><div class="col-md-4"><label class="form-label">نام انگلیسی</label><input asp-for="NameEn" class="form-control" dir="ltr" /></div><div class="col-md-4"><label class="form-label required">ساعت شروع</label><input asp-for="StartTime" type="time" class="form-control" /></div><div class="col-md-4"><label class="form-label required">ساعت پایان</label><input asp-for="EndTime" type="time" class="form-control" /></div><div class="col-md-4"><label class="form-label required">ساعت کار</label><input asp-for="WorkHours" type="number" step="0.25" class="form-control" /></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Shifts">انصراف</a><button class="btn btn-primary">ذخیره</button></div></form></div>
