@using HrPanel.UI.Common.Constants
@model IReadOnlyCollection<ExternalPersonDto>
@{
    ViewData[ViewDataKeys.Title] = "اشخاص بیرونی";
    ViewData[ViewDataKeys.PageTitle] = "اشخاص بیرونی";
    ViewData[ViewDataKeys.PageDescription] = "مدیریت افرادی که در روابط سازمانی حضور دارند اما کارمند نیستند";
}
<div class="page-actions"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#external-modal">افزودن شخص</button></div>
<section class="content-card">
    <form method="get" class="filter-bar">
        <div class="filter-search"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" class="form-control" placeholder="نام یا نام کاربری قدیمی" /></div>
        <select name="isActive" class="form-select"><option value="">همه</option><option value="true">فعال</option><option value="false">غیرفعال</option></select>
        <button class="btn btn-dark">جست‌وجو</button><a class="btn btn-outline-secondary" asp-action="ExternalPeople">پاک‌کردن</a>
    </form>
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateViewModel("شخصی یافت نشد", "شخص بیرونی جدید را ثبت کنید", "bi-person-lines-fill")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead><tr><th>نام</th><th>نام کاربری قدیمی</th><th>وضعیت</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr><td>@item.DisplayName</td><td dir="ltr">@(item.LegacyUsername ?? "—")</td><td><span class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td><td class="table-actions"><button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="modal" data-bs-target="#external-edit-@item.Id">ویرایش</button><form asp-action="ExternalPersonStatus" asp-route-externalPersonId="@item.Id" method="post"><input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" /><button class="btn btn-sm btn-link">@(item.IsActive ? "غیرفعال‌کردن" : "فعال‌کردن")</button></form></td></tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var item in Model)
        {
            <div class="modal fade" id="external-edit-@item.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="EditExternalPerson" asp-route-externalPersonId="@item.Id" method="post"><div class="modal-header"><h2 class="modal-title fs-5">ویرایش شخص بیرونی</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="بستن"></button></div><div class="modal-body"><label class="form-label">نام نمایشی</label><input name="DisplayName" value="@item.DisplayName" class="form-control mb-3" required /><label class="form-label">نام کاربری قدیمی</label><input name="LegacyUsername" value="@item.LegacyUsername" class="form-control" dir="ltr" /></div><div class="modal-footer"><button class="btn btn-primary">ذخیره</button></div></form></div></div></div>
        }
    }
</section>
<div class="modal fade" id="external-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="CreateExternalPersonFromView" method="post"><div class="modal-header"><h2 class="modal-title fs-5">ثبت شخص بیرونی</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="بستن"></button></div><div class="modal-body"><label class="form-label">نام نمایشی</label><input name="DisplayName" class="form-control mb-3" required /><label class="form-label">نام کاربری قدیمی</label><input name="LegacyUsername" class="form-control" dir="ltr" /></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary">ثبت</button></div></form></div></div></div>
